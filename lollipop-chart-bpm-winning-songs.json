{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": "Eurovision Winning BPM",

  "data": {
    "url": "data/Eurovision_Winning_BPM.csv"
  },

  "transform": [
    {
      "bin": {
        "step": 10
      },
      "field": "BPM",
      "as": ["bin_start", "bin_end"]
    },
    {
      "aggregate": [
        {
          "op": "count",
          "as": "count"
        }
      ],
      "groupby": ["bin_start", "bin_end"]
    },
  {
    "calculate": "datum.bin_start + 3.5",
    "as": "bar_start"
  },

  {
    "calculate": "datum.bin_end - 3.5",
    "as": "bar_end"
  },
  {
    "calculate": "datum.bin_start + 2.5",
    "as": "rect_start"
  },

  {
    "calculate": "datum.bin_end - 2.5",
    "as": "rect_end"
  }
  ],

  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusTopLeft": 4,
        "cornerRadiusTopRight": 4,
        "color": "#df75ed"
      },
      "encoding": {
        "x": {
          "field": "bar_start",
          "type": "quantitative",
          "title": "BPM Range",
          "axis": {
          "values": [70, 80, 90, 100, 110, 120, 130, 140, 150, 160]
          }
        },
        "x2": {
          "field": "bar_end"
        },
        "y": {
          "field": "count",
          "type": "quantitative",
          "title": "Number of Winners",
          "axis": {
            "values": [0, 1, 2, 3],
            "grid": false
          }
        }
      }
    },

    {
      "mark": {
        "type": "rect",
        "width": 26,
        "height": 40,
        "color": "#df75ed"
      },
      "encoding": {
        "x": {
          "field": "rect_start",
          "type": "quantitative"
        },
        "x2": {
          "field": "rect_end"
        },
        "y": {
          "field": "count",
          "type": "quantitative"
        },
"tooltip": [
  {
    "field": "bin_start",
    "type": "quantitative",
    "title": "BPM From"
  },
  {
    "field": "bin_end",
    "type": "quantitative",
    "title": "BPM To"
  },
  {
    "field": "count",
    "type": "quantitative",
    "title": "Number of Winners"
  }
]
      }
    },
    {
  "transform": [
    {
      "joinaggregate": [
        { "op": "max", "field": "count", "as": "maxCount" }
      ]
    },
    {
      "filter": "datum.count === datum.maxCount"
    }
  ],

  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#c09703",
        "strokeWidth": 2
      },
      "encoding": {
        "x": { "field": "rect_start", "type": "quantitative" },
        "y": { "field": "count", "type": "quantitative" },
        "x2": { "value": 220 },
        "y2": { "value": 0 }
      }
    },

    {
      "mark": {
        "type": "text",
        "color": "#c09703",
        "fontSize": 11,
        "fontWeight": "bold",
        "dx" : -140,
        "dy": -5
      },
      "encoding": {
        "x": { "field": "rect_start", "type": "quantitative" },
        "y": { "field": "count", "type": "quantitative" },
        "text": { "value": ["BPM from 130 to 140 is", "most frequent winning BPM!"] }
      }
    }
  ]
}
  ],

  "width": 400,
  "height": 200,

"config": {
  "background": "#000000",
  "view": {
    "stroke": null,
    "fill": "#000000"
  },
  "axis": {
    "grid": false,
    "labelColor": "white",
    "titleColor": "white",
    "domainColor": "white",
    "tickColor": "white"
  },
  "title": {
    "color": "white",
    "fontSize": 16,
    "fontWeight": "bold"
  },
  "style": {
    "cell": {
      "fill": "#000000"
    }
  }
}
}