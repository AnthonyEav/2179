{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": "Eurovision Winner Points (2016–2026)",

  "data": {
    "url": "data/Eurovision_past_10_winners.csv"
  },

  "width": "container",

  "transform": [
    {
      "fold": ["Jury", "Public"],
      "as": ["Category", "amount"]
    },
    {
      "filter": "datum.Year >= 2016 && datum.Year <= 2026"
    }
  ],

  "layer": [
    {
      "mark": "bar",

      "encoding": {
        "x": { "field": "Year",
        "type": "ordinal",  
        "axis": {
        "title": "Year",
        "labelAngle": 0
        } },

        "y": {
          "field": "amount",
          "type": "quantitative",
          "stack": "zero",
          "scale": { "domain": [0, 900] },
          "axis": {
            "grid": false,
            "title": "Overall Points"
          }
        },

        "color": {
          "field": "Category",
          "type": "nominal",
          "scale": {
          "domain": ["Jury", "Public"],
          "range": ["#40E0D0", "#4CAF50"]
          }
        },

        "tooltip": [
          { "field": "Year", "type": "ordinal" },
          { "field": "Category", "type": "nominal" },
          { "field": "amount", "type": "quantitative" }
        ]
      }
    },

    {
      "transform": [
        {
          "aggregate": [
            { "op": "sum", "field": "amount", "as": "total" }
          ],
          "groupby": ["Year"]
        },
        {
          "joinaggregate": [
            { "op": "max", "field": "total", "as": "maxTotal" }
          ]
        },
        {
          "filter": "datum.total == datum.maxTotal"
        }
      ],

      "mark": {
        "type": "text",
        "dy": -10,
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#c09703"
      },

      "encoding": {
        "x": { "field": "Year", "type": "ordinal" },
        "y": { "field": "total", "type": "quantitative" },
        "text": { "field": "total" }
      }
    },
  {
  "transform": [
    {
      "aggregate": [
        { "op": "sum", "field": "amount", "as": "total" }
      ],
      "groupby": ["Year"]
    },
    {
      "joinaggregate": [
        { "op": "max", "field": "total", "as": "maxTotal" }
      ]
    },
    {
      "filter": "datum.total == datum.maxTotal"
    }
  ],

  "mark": {
    "type": "rule",
    "stroke": "#c09703",
    "strokeWidth": 2
  },

  "encoding": {
    "x": { "field": "Year", "type": "ordinal" },
    "y": { "field": "total", "type": "quantitative" },
    "x2": { "value": 160 }
  }
},
{
  "data": {
    "values": [
      {
        "x": 2023,
        "y": 760,
        "label": "Highest decade win!"
      }
    ]
  },

  "mark": {
    "type": "text",
    "fontSize": 12,
    "fontWeight": "bold",
    "color": "#c09703"
  },

  "encoding": {
    "x": { "field": "x", "type": "ordinal" },
    "y": { "field": "y", "type": "quantitative" },
    "text": { "field": "label" }
  }
}
  ],

"config": {
  "background": "#000000",
  "view": {
    "stroke": null,
    "fill": "#000000"
  },
  "axis": {
    "grid": false,
    "labelColor": "white",
    "titleColor": "white",
    "domainColor": "white",
    "tickColor": "white"
  },
  "title": {
    "color": "white",
    "fontSize": 16,
    "fontWeight": "bold"
  },
  "legend": {
    "labelColor": "white",
    "titleColor": "white"
  },
  "style": {
    "cell": {
      "fill": "#000000"
    }
  }
}
}