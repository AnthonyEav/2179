{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": "Eurovision Genres (2009–2026)",

  "data": {
    "url": "data/song_data.csv"
  },

  "width": 270,
  "height": 270,

"transform": [
  {
    "aggregate": [
      { "op": "count", "as": "count" }
    ],
    "groupby": ["Genre"]
  },
  {
    "window": [
      { "op": "row_number", "as": "row" }
    ]
  },
  {
  "calculate": "datum.Genre === 'Rock' ? datum.row - 2 : datum.row",
  "as": "rowAdj"
},
{
  "calculate": "datum.Genre === 'Traditional' ? datum.row - 28 : datum.count",
  "as": "countAdj"
}
],

  "mark": {
    "type": "text"
  },

  "encoding": {
    "x": { "field": "rowAdj", "type": "quantitative", "axis": null },
"y": { "field": "countAdj", "type": "quantitative", "axis": null },

    "text": { "field": "Genre" },

    "size": {
      "field": "count",
      "type": "quantitative",
      "legend": null,
      "scale": {
        "range": [15, 120]
      }
    },

"color": {
  "field": "Genre",
  "type": "nominal",
  "legend": null,
  "scale": {
          "domain": ["Rock", "Pop", "Ballad", "Traditional", "Dance", "Opera"],
          "range": ["#8D6E63", "#4F8FD9", "#E6C84F", "#D65A5A", "#7E57C2", "#E38B4D"]
        }
    },
    "tooltip": [
    { "field": "Genre", "type": "nominal" },
    { "field": "count", "type": "quantitative" }
  ]
  },

"config": {
  "background": "#000000",
  "view": {
    "stroke": null,
    "fill": "#000000"
  },
  "axis": {
    "grid": false,
    "labelColor": "white",
    "titleColor": "white",
    "domainColor": "white",
    "tickColor": "white"
  },
  "title": {
    "color": "white",
    "fontSize": 16,
    "fontWeight": "bold"
  },
  "legend": {
    "labelColor": "white",
    "titleColor": "white"
  },
  "style": {
    "cell": {
      "fill": "#000000"
    }
  }
}
}