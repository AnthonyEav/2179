{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": "Eurovision Song Contest Participation (Europe)",

  "width": 450,
  "height": 450,

  "projection": {
    "type": "mercator",
    "center": [13, 55],
    "scale": 350
  },

  "data": {
    "url": "https://raw.githubusercontent.com/leakyMirror/map-of-europe/master/TopoJSON/europe.topojson",
    "format": {
      "type": "topojson",
      "feature": "europe"
    }
  },

  "transform": [
    {
      "lookup": "properties.NAME",
      "from": {
        "data": {
          "url": "data/Eurovision_Country_Participation.csv"
        },
        "key": "Country",
        "fields": ["Count"]
      }
    },
    {
      "calculate": "isValid(datum.Count) ? datum.Count : 0",
      "as": "Participation"
    }
  ],

  "layer": [

    {
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 0.6
      },

      "encoding": {
        "color": {
          "field": "Participation",
          "type": "quantitative",
          "scale": {
            "scheme": "blues",
            "domain": [0, 70]
          }
        },

        "tooltip": [
          {
            "field": "properties.NAME",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "Participation",
            "type": "quantitative",
            "title": "Count"
          }
        ]
      }
    },

    {
      "transform": [
        {
          "filter": "datum.Participation == 70"
        }
      ],

      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#c09703",
        "strokeWidth": 3
      }
    },
    {
  "data": {
    "values": [
      {
        "lon1": 2,
        "lat1": 46,
        "lon2": -5,
        "lat2": 67
      },
      {
        "lon1": 10,
        "lat1": 51,
        "lon2": -5,
        "lat2": 67
      }
    ]
  },

  "mark": {
    "type": "rule",
    "stroke": "#c09703",
    "strokeWidth": 2
  },

  "encoding": {
    "longitude": {"field": "lon1"},
    "latitude": {"field": "lat1"},
    "longitude2": {"field": "lon2"},
    "latitude2": {"field": "lat2"}
  }
},
{
  "data": {
    "values": [
      {
        "lon": -18,
        "lat": 69,
        "text": "France and Germany have",
        "dy": -6
      },
      {
        "lon": -17,
        "lat": 68,
        "text": "participated every year!",
        "dy": 8
      }
    ]
  },

  "mark": {
    "type": "text",
    "align": "left",
    "dx": 5,
    "fontSize": 12,
    "fontWeight": "bold",
    "color": "#c09703"
  },

  "encoding": {
    "longitude": {"field": "lon"},
    "latitude": {"field": "lat"},
    "text": {"field": "text"},
    "dy": {"field": "dy"}
  }
}
  ],

"config": {
  "background": "#000000",
  "view": {
    "stroke": null,
    "fill": "#000000"
  },
  "axis": {
    "grid": false,
    "labelColor": "white",
    "titleColor": "white",
    "domainColor": "white",
    "tickColor": "white"
  },
  "legend": {
  "titleColor": "white",
  "labelColor": "white",
  "gradientLength": 200
},
  "title": {
    "color": "white",
    "fontSize": 16,
    "fontWeight": "bold"
  },
  "style": {
    "cell": {
      "fill": "#000000"
    }
  }
}
}   