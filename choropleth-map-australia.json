{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": "Eurovision Song Contest Participation (Australia)",
  "width": 450,
  "height": 450,

  "projection": {
    "type": "equalEarth",
    "center": [130, 565],
    "scale": 450
  },

  "data": {
    "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/3_choropleth_map/js/ne_110m_admin_0_countries.topojson",
    "format": {
      "type": "topojson",
      "feature": "ne_110m_admin_0_countries"
    }
  },

  "transform": [
    {
      "lookup": "properties.NAME",
      "from": {
        "data": {
          "url": "data/Eurovision_Country_Participation.csv"
        },
        "key": "Country",
        "fields": ["Count"]
      }
    },

    {
      "calculate": "isValid(datum.Count) ? datum.Count : 0",
      "as": "Participation"
    }
  ],

  "mark": {
    "type": "geoshape",
    "stroke": "white",
    "strokeWidth": 0.5
  },

  "encoding": {
    "color": {
      "condition": {
        "test": "datum.Participation > 0",
        "field": "Participation",
        "type": "quantitative",
        "scale": {
          "scheme": "blues"
        }
      },
      "value": "white",
      "title": "Participation"
    },

    "tooltip": [
      {
        "field": "properties.NAME",
        "type": "nominal",
        "title": "Country"
      },
      {
        "field": "Participation",
        "type": "quantitative",
        "title": "Count"
      }
    ]
  },

"config": {
  "background": "#000000",
  "view": {
    "stroke": null,
    "fill": "#000000"
  },
  "axis": {
    "grid": false,
    "labelColor": "white",
    "titleColor": "white",
    "domainColor": "white",
    "tickColor": "white"
  },
  "legend": {
  "titleColor": "white",
  "labelColor": "white",
  "gradientLength": 200
},
  "title": {
    "color": "white",
    "fontSize": 16,
    "fontWeight": "bold"
  },
  "style": {
    "cell": {
      "fill": "#000000"
    }
  }
}
}