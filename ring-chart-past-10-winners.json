{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": "Eurovision Winning Genres",

  "data": {
    "url": "data/Eurovision_past_10_winners.csv"
  },

  "transform": [
    {
      "aggregate": [
        { "op": "count", "as": "count" }
      ],
      "groupby": ["Genre"]
    }
  ],

  "layer": [
    {
      "mark": {
        "type": "arc",
        "innerRadius": 70
      },

      "encoding": {
        "theta": { "field": "count", "type": "quantitative" },
        "color": { "field": "Genre", "type": "nominal", "scale": {
          "domain": ["Rock", "Pop", "Ballad", "Traditional", "Dance", "Opera"],
          "range": ["#8D6E63", "#4F8FD9", "#E6C84F", "#D65A5A", "#7E57C2", "#E38B4D"]
          },
          "legend": {
        "labelColor": "white",
        "titleColor": "white"
        } },
        "tooltip": [
          { "field": "Genre", "type": "nominal" },
          { "field": "count", "type": "quantitative" }
        ]
      }
    },

    {
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 12,
        "color": "white"
      },

      "encoding": {
        "text": { "value": ["Past Decade", "Winning Genres"] }
      }
    }
  ],
"config": {
  "background": "#000000",
  "view": {
    "stroke": null,
    "fill": "#000000"
  },
  "title": {
    "color": "white",
    "fontSize": 16,
    "fontWeight": "bold"
  }
}
}