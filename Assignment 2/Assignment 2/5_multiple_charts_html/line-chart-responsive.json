{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "data": {
    "url": "players_15.csv"
  },

  "width": "container",

  "layer": [
    {
      "mark": {
        "type": "line",
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {
          "field": "age",
          "type": "quantitative",
          "title": "Age"
        },
        "y": {
          "field": "potential",
          "type": "quantitative",
          "title": "Potential"
        }
      }
    },

    {
      "mark": {
        "type": "point",
        "opacity": 0
      },
      "encoding": {
        "x": { "field": "age", "type": "quantitative" },
        "y": { "field": "potential", "type": "quantitative" },

        "tooltip": [
          { "field": "age", "type": "quantitative", "title": "Age" },
          { "field": "potential", "type": "quantitative", "title": "Potential" }
        ]
      }
    }
  ]
}