{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": "Eurovision Wins",

  "data": {
    "url": "data/eurovision_winners_all_years.csv"
  },

"transform": [
  {
    "aggregate": [
      {
        "op": "count",
        "as": "count"
      }
    ],
    "groupby": ["Country", "FlagURL"]
  },
  {
    "window": [
      {
        "op": "row_number",
        "as": "order"
      }
    ],
    "sort": [
      {
        "field": "count",
        "order": "descending"
      }
    ]
  },
{
  "calculate": "datum.Country === 'Ireland' || datum.Country === 'Sweden' ? 'gold' : datum.count >= 5 ? 'silver' : datum.Country === 'Israel' ? 'bronze' : 'blue'",
  "as": "medal"
}
],
"encoding": {
  "x": {
    "field": "count",
    "type": "quantitative",
    "title": "Number of Wins",
    "axis": {
      "values": [0, 1, 2, 3, 4, 5, 6, 7],
      "grid": false
    }
  },

  "y": {
    "field": "Country",
    "type": "nominal",
    "title": "Country",
  "sort": {
    "field": "order",
    "op": "min"
  },
    "axis": {
      "grid": false,
      "labelAngle": 0
    }
  },

  "color": {
    "field": "medal",
    "type": "nominal",
    "legend": null,
    "scale": {
      "domain": ["gold", "silver", "bronze", "blue"],
      "range": ["#FFD700", "#C0C0C0", "#CD7F32", "#2B4C7E"]
    }
  }
},
"layer": [
{
  "mark": {
    "type": "bar",
    "cornerRadiusTopLeft": 4,
    "cornerRadiusTopRight": 4,
    "size": 6
  }
},
  {
    "mark": {
      "type": "image",
      "width": 24,
      "height": 24
    },
    "encoding": {
      "url": {
        "field": "FlagURL"
      },
      "tooltip": [
        {
          "field": "Country",
          "type": "ordinal"
        },
        {
          "field": "count",
          "type": "quantitative",
          "title": "Number of Wins"
        }
      ]
    }
  },
{
  "transform": [
    {
      "filter": "datum.Country === 'Sweden'"
    }
  ],
"mark": {
  "type": "text",
  "align": "center",
  "baseline": "top",
  "dy": 18,
  "color": "#c09703",
  "fontSize": 13,
  "fontWeight": "bold"
},
  "encoding": {
    "x": { "field": "count", "type": "quantitative" },
    "y": { "field": "Country", "type": "nominal" },
    "text": {
      "value": "Ireland and Sweden\nhave the most wins (7)"
    }
  }
}
],

  "width": 600,
  "height": 600,

"config": {
  "background": "#000000",
  "view": {
    "stroke": null,
    "fill": "#000000"
  },
  "axis": {
    "grid": false,
    "labelColor": "white",
    "titleColor": "white",
    "domainColor": "white",
    "tickColor": "white"
  },
  "title": {
    "color": "white",
    "fontSize": 16,
    "fontWeight": "bold"
  },
  "style": {
    "cell": {
      "fill": "#000000"
    }
  }
}
}